generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  QUEUED
  RUNNING
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  jobs      Job[]
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Job {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  type           String
  status         JobStatus    @default(QUEUED)
  priority       JobPriority  @default(NORMAL)
  payload        Json
  result         Json?
  errorMessage   String?
  idempotencyKey String?
  maxAttempts    Int          @default(3)
  attemptCount   Int          @default(0)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  attempts       JobAttempt[]
  events         JobEvent[]
  dependencies   JobDependency[] @relation("DependentJob")
  dependents     JobDependency[] @relation("DependencyJob")

  @@unique([projectId, idempotencyKey])
  @@index([projectId, status, createdAt])
  @@index([status, priority, createdAt])
}

model JobAttempt {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempt     Int
  workerId    String?
  status      String
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  errorMessage String?

  @@unique([jobId, attempt])
  @@index([jobId, startedAt])
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
}

model JobDependency {
  id             String @id @default(cuid())
  dependentJobId String
  dependencyJobId String
  dependentJob   Job    @relation("DependentJob", fields: [dependentJobId], references: [id], onDelete: Cascade)
  dependencyJob  Job    @relation("DependencyJob", fields: [dependencyJobId], references: [id], onDelete: Cascade)

  @@unique([dependentJobId, dependencyJobId])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  eventType String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}
