{
  "name": "devmesh",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @devmesh/web",
    "dev:api": "npm run dev --workspace @devmesh/api",
    "dev:worker": "npm run dev --workspace @devmesh/worker",
    "build": "npm run build --workspace @devmesh/web && npm run build --workspace @devmesh/api && npm run build --workspace @devmesh/worker",
    "db:generate": "npm run db:generate --workspace @devmesh/database",
    "db:migrate": "npm run db:migrate --workspace @devmesh/database",
    "test": "node --test apps/worker/test/*.test.js"
  }
}
